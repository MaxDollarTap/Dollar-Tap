# Copie ces lignes dans les "Environment Variables" de ton hébergeur (jamais dans le jeu, jamais sur GitHub)
BASE_URL=https://ton-app.onrender.com
BOT_TOKEN=123456:ABC-DEF...            # donné par @BotFather
PAYPAL_ENV=sandbox                      # "sandbox" pour tester, "live" pour de vrais paiements
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
DATA_DIR=/var/data                      # dossier persistant (disque de l'hébergeur)
ALLOW_GUESTS=1                          # 1 = on peut jouer depuis un navigateur sans Telegram
TG_SECRET=mets-ici-une-longue-phrase-secrete-au-hasard   # protège l'entrée du bot
ADMIN_ID=                               # TON identifiant Telegram (nombre) : pour la commande /channel
CHANNEL_ID=                             # ex. -1001234567890 (ton canal) ou @nom_du_canal
